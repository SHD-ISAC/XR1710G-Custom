Subject: wifi: mt76: validate the local station-statistics extensions

Upstream 56c8b4a4 now validates the common ALL_STA_INFO event header and
station-array lengths. Extend its element-size dispatch for the local
airtime event, and reject truncated local PER_STA_INFO replies before
reading sta_num. Do not reapply the superseded common validation hunk.

--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -690,6 +690,9 @@ mt7996_mcu_rx_all_sta_info_event(struct mt7996_dev *dev, struct sk_buff *skb)
 	case UNI_ALL_STA_TXRX_MSDU_COUNT:
 		elem_size = sizeof(res->msdu_cnt[0]);
 		break;
+	case UNI_ALL_STA_TXRX_AIR_TIME:
+		elem_size = sizeof(res->airtime[0]);
+		break;
 	default:
 		return;
 	}
@@ -5985,6 +5988,11 @@ int mt7996_mcu_get_per_sta_info(struct mt7996_phy *phy, u16 tag)
 		if (ret)
 			return ret;
 
+		if (skb->len < sizeof(*res)) {
+			dev_kfree_skb(skb);
+			return -EINVAL;
+		}
+
 		res = (struct mt7996_mcu_per_sta_info_event *)skb->data;
 
 		resp_sta_num = le16_to_cpu(res->sta_num);
